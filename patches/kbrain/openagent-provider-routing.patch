diff --git a/internal/routing/openagent_provider_selection_test.go b/internal/routing/openagent_provider_selection_test.go
new file mode 100644
index 0000000..f864c5f
--- /dev/null
+++ b/internal/routing/openagent_provider_selection_test.go
@@ -0,0 +1,122 @@
+package routing
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+)
+
+func TestOpenAgentSelectedProviderDoesNotImplicitlyFailOver(t *testing.T) {
+	for _, streaming := range []bool{false, true} {
+		for _, tc := range []struct {
+			name     string
+			failover map[string]any
+		}{
+			{"unset", nil},
+			{"disabled", map[string]any{"enabled": false, "queue": []any{"casa"}, "maxSwitches": 3}},
+			{"empty queue", map[string]any{"enabled": true, "queue": []any{}, "maxSwitches": 3}},
+			{"zero switches", map[string]any{"enabled": true, "queue": []any{"casa"}, "maxSwitches": 0}},
+		} {
+			t.Run(fmt.Sprintf("%s/stream=%v", tc.name, streaming), func(t *testing.T) {
+				ResetFailoverBreakers()
+				var selectedCalls, otherCalls atomic.Int32
+				selected := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					selectedCalls.Add(1)
+					if r.Header.Get("Authorization") != "Bearer selected-key" {
+						t.Error("wrong selected credentials")
+					}
+					w.WriteHeader(http.StatusForbidden)
+					fmt.Fprint(w, `{"error":{"message":"This account only allows Codex official clients","type":"forbidden_error"}}`)
+				}))
+				defer selected.Close()
+				other := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					otherCalls.Add(1)
+					w.Header().Set("Content-Type", "text/event-stream")
+					fmt.Fprint(w, "data: {\"choices\":[{\"delta\":{\"content\":\"wrong provider\"}}]}\n\ndata: [DONE]\n\n")
+				}))
+				defer other.Close()
+				retry := map[string]any{"mode": "off"}
+				if tc.failover != nil {
+					retry["failover"] = tc.failover
+				}
+				cfg := &config.Config{DefaultProvider: "casa", Models: map[string]config.Model{
+					"shared": {ID: "shared", Context: 200000, Providers: []string{"casa", "selected"}},
+				}, Providers: map[string]config.Provider{
+					"selected": {Type: "codex", API: ai.APIChatCompletions, BaseURL: selected.URL, APIKey: "selected-key", RetryPolicy: retry},
+					"casa":     {Type: "codex", API: ai.APIChatCompletions, BaseURL: other.URL, APIKey: "other-key", RetryPolicy: map[string]any{"mode": "off"}},
+				}}
+				route, err := ResolveFailoverRouteContext(t.Context(), cfg, "shared", "selected", false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for attempt := int32(1); attempt <= 2; attempt++ {
+					// Verify both normal 403 handling and a previously opened circuit.
+					if attempt == 2 {
+						recordTarget(breakerKey("selected", "shared"), false, true, 1, time.Now())
+					}
+					if streaming {
+						_, _, err = route.Client.Stream(t.Context(), ai.Request{Model: "shared"}, nil, nil, nil)
+					} else {
+						_, _, err = route.Client.Complete(t.Context(), ai.Request{Model: "shared"})
+					}
+					if err == nil || selectedCalls.Load() != attempt || otherCalls.Load() != 0 {
+						t.Fatalf("selected=%d other=%d error=%v", selectedCalls.Load(), otherCalls.Load(), err)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestOpenAgentFailoverHonorsExplicitQueue(t *testing.T) {
+	off := false
+	providers := map[string]config.Provider{}
+	for _, name := range []string{"selected", "first", "second", "unlisted", "disabled", "foreign", "inactive"} {
+		providers[name] = config.Provider{Type: "codex", API: ai.APIChatCompletions, BaseURL: "http://fixture.invalid", APIKey: "fixture", ActiveModels: []string{"shared"}}
+	}
+	p := providers["disabled"]
+	p.Enabled = &off
+	providers["disabled"] = p
+	p = providers["foreign"]
+	p.Type = "claude_code"
+	providers["foreign"] = p
+	p = providers["inactive"]
+	p.ActiveModels = []string{"other"}
+	providers["inactive"] = p
+	p = providers["selected"]
+	p.RetryPolicy = map[string]any{"failover": map[string]any{"enabled": true, "queue": []any{"second", "disabled", "missing", "foreign", "inactive", "first", "second", "selected"}, "maxSwitches": 2}}
+	providers["selected"] = p
+	cfg := &config.Config{Providers: providers, Models: map[string]config.Model{"shared": {ID: "shared", Context: 200000, Providers: []string{"unlisted", "first", "second", "selected", "disabled", "foreign", "inactive"}}}}
+	route, err := ResolveFailoverRouteContext(t.Context(), cfg, "shared", "selected", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := route.Client.(*FailoverClient)
+	var names []string
+	for _, candidate := range client.candidates {
+		names = append(names, candidate.name)
+	}
+	if !slices.Equal(names, []string{"selected", "second", "first"}) {
+		t.Fatalf("queue = %v", names)
+	}
+}
+
+func TestOpenAgentFailoverPolicyRejectsMalformedOptIn(t *testing.T) {
+	for _, policy := range []map[string]any{
+		{"failover": true},
+		{"failover": map[string]any{"enabled": "true"}},
+		{"failover": map[string]any{"queue": "other"}},
+		{"failover": map[string]any{"queue": []any{1}}},
+	} {
+		if _, err := ParseProviderRuntimeSettings(config.Provider{RetryPolicy: policy}); err == nil {
+			t.Fatalf("accepted malformed failover: %v", policy)
+		}
+	}
+}
