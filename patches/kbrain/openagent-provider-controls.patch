@@ -0,0 +1,131 @@
+package routing
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestOpenAgentLongContextWireRequest(t *testing.T) {
+	t.Setenv("K_BRAIN_HOME", t.TempDir())
+	for _, optIn := range []bool{false, true} {
+		for _, failover := range []bool{false, true} {
+			t.Run(fmt.Sprintf("optIn=%v/failover=%v", optIn, failover), func(t *testing.T) {
+				requests := make(chan string, 2)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					var body struct {
+						Model string `json:"model"`
+					}
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Error(err)
+					}
+					if body.Model != "claude-opus-5.5" {
+						t.Errorf("model ID changed: %q", body.Model)
+					}
+					requests <- r.Header.Get("anthropic-beta")
+					w.Header().Set("Content-Type", "text/event-stream")
+					fmt.Fprint(w, "data: {\"type\":\"message_start\",\"message\":{}}\n\ndata: {\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"ok\"}}\n\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"}}\n\ndata: {\"type\":\"message_stop\"}\n\n")
+				}))
+				defer server.Close()
+				headers := []config.CustomHeader{{Key: "Anthropic-Beta", Value: "existing-beta"}, {Key: "X-Trace", Value: "keep"}}
+				cfg := &config.Config{DefaultModel: "claude-opus-5.5", DefaultProvider: "p", Providers: map[string]config.Provider{
+					"p": {API: ai.APIMessages, Type: "claude_code", BaseURL: server.URL, APIKey: "fixture-only", CustomHeaders: headers},
+				}, Models: map[string]config.Model{"claude-opus-5.5": {Providers: []string{"p"}, Context: 200000, MaxOut: 1024, Supports1M: optIn}}}
+				route, err := ResolveRoute(cfg, "", "", false)
+				if failover {
+					route, err = ResolveFailoverRouteContext(t.Context(), cfg, "", "", false)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if optIn && route.ContextLimit != 1000000 {
+					t.Fatalf("context limit %d", route.ContextLimit)
+				}
+				if _, _, err = route.Client.Stream(t.Context(), ai.Request{Model: route.APIModel, MaxTokens: 1024}, nil, nil, nil); err != nil {
+					t.Fatal(err)
+				}
+				got := <-requests
+				if !strings.Contains(got, "existing-beta") || strings.Contains(got, "context-1m-2025-08-07") != optIn {
+					t.Fatalf("beta header %q", got)
+				}
+				if !reflect.DeepEqual(headers, cfg.Providers["p"].CustomHeaders) || headers[0].Value != "existing-beta" {
+					t.Fatal("stored headers mutated")
+				}
+			})
+		}
+	}
+}
+func TestOpenAgentLongContextHeaderMerging(t *testing.T) {
+	p := config.Provider{API: ai.APIMessages, CustomHeaders: []config.CustomHeader{
+		{Key: "Anthropic-Beta", Value: "other, context-1m-2025-08-07"}, {Key: "anthropic-beta", Value: "other, next"}, {Key: "X-Trace", Value: "keep"},
+	}}
+	got := providerForModel(p, config.Model{Supports1M: true})
+	if len(got.CustomHeaders) != 2 || got.CustomHeaders[1].Value != "other,context-1m-2025-08-07,next" {
+		t.Fatalf("header merge: %v", got.CustomHeaders)
+	}
+	p.API = ai.APIChatCompletions
+	if got := providerForModel(p, config.Model{Supports1M: true}); !reflect.DeepEqual(got, p) {
+		t.Fatal("Anthropic opt-in sent to OpenAI API")
+	}
+}
+func TestOpenAgentDisabledProviderRoutesAndFailover(t *testing.T) {
+	t.Setenv("K_BRAIN_HOME", t.TempDir())
+	disabled := false
+	cfg := &config.Config{Providers: map[string]config.Provider{
+		"on":  {API: ai.APIMessages, Type: "claude_code", BaseURL: "http://127.0.0.1:1", APIKey: "fixture-only"},
+		"off": {Enabled: &disabled, API: ai.APIMessages, Type: "claude_code", BaseURL: "http://127.0.0.1:1", APIKey: "fixture-only"},
+	}, Models: map[string]config.Model{"shared": {Providers: []string{"on", "off"}, Context: 1000000, MaxOut: 1024}}}
+	for _, optional := range []bool{false, true} {
+		if _, err := ResolveRoute(cfg, "shared", "off", optional); err == nil {
+			t.Fatal("disabled direct route accepted")
+		}
+		if _, err := ResolveFailoverRouteContext(t.Context(), cfg, "shared", "off", optional); err == nil {
+			t.Fatal("disabled failover primary accepted")
+		}
+	}
+	if _, err := ClientForProvider(cfg.Providers["off"], "off", 0); err == nil {
+		t.Fatal("disabled client accepted")
+	}
+	if _, err := ClientForProviderOptional(cfg.Providers["off"], "off", 0); err == nil {
+		t.Fatal("disabled optional client accepted")
+	}
+	route, err := ResolveFailoverRouteContext(t.Context(), cfg, "shared", "on", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := route.Client.(*FailoverClient)
+	if len(client.candidates) != 1 || client.candidates[0].name != "on" {
+		t.Fatal("disabled failover candidate")
+	}
+	p := cfg.Providers["off"]
+	p.Enabled = nil
+	cfg.Providers["off"] = p
+	m := cfg.Models["shared"]
+	mo := m
+	mo.Supports1M = true
+	m.SetProviderMetadata("off", mo)
+	cfg.Models["shared"] = m
+	route, err = ResolveFailoverRouteContext(t.Context(), cfg, "shared", "on", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client = route.Client.(*FailoverClient)
+	if len(client.candidates) != 2 {
+		t.Fatal("reenabled provider missing")
+	}
+	for _, candidate := range client.candidates {
+		hasBeta := false
+		for _, h := range candidate.provider.CustomHeaders {
+			hasBeta = hasBeta || strings.Contains(h.Value, "context-1m-2025-08-07")
+		}
+		if hasBeta != (candidate.name == "off") {
+			t.Fatal("opt-in leaked between failover providers")
+		}
+	}
+}
