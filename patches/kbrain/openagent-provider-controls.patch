+package backend
+
+import (
+	"encoding/json"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestOpenAgentProviderControlsSettingsRoundTrip(t *testing.T) {
+	t.Setenv("K_BRAIN_HOME", t.TempDir())
+	cfg := &config.Config{DefaultProvider: "p", DefaultModel: "m", Providers: map[string]config.Provider{
+		"p": {API: "anthropic-messages", APIKey: "fixture-only", ActiveModels: []string{"m"}},
+	}, Models: map[string]config.Model{"m": {ID: "m", Providers: []string{"p"}, Context: 200000, MaxOut: 8192}}}
+	store := NewSettingsStore(cfg, func(next *config.Config) error { return next.Save() })
+	server := &Server{settings: store}
+	put := func(body string) settingsProjection {
+		t.Helper()
+		out := httptest.NewRecorder()
+		server.ServeHTTP(out, httptest.NewRequest(http.MethodPut, "/v1/settings", strings.NewReader(body)))
+		if out.Code != http.StatusOK {
+			t.Fatalf("settings update %d: %s", out.Code, out.Body.String())
+		}
+		if strings.Contains(out.Body.String(), "fixture-only") {
+			t.Fatal("settings exposed a key")
+		}
+		var result settingsProjection
+		if err := json.Unmarshal(out.Body.Bytes(), &result); err != nil {
+			t.Fatal(err)
+		}
+		return result
+	}
+	result := put(`{"providers":[{"id":"p","enabled":false,"models":[{"id":"m","supports1M":true,"contextWindow":1000000,"limitsSource":"user"}]}]}`)
+	if len(result.Models) != 0 || len(result.Providers) != 1 || result.Providers[0].Enabled || len(result.Providers[0].Models) != 1 || !result.Providers[0].Models[0].Supports1M {
+		t.Fatalf("disabled projection: %+v", result)
+	}
+	for _, endpoint := range []string{"/v1/text/generate", "/v1/generate"} {
+		out := httptest.NewRecorder()
+		server.ServeHTTP(out, httptest.NewRequest(http.MethodPost, endpoint, strings.NewReader(`{"model":{"provider":"p","model":"m"},"messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}`)))
+		if out.Code != http.StatusBadRequest {
+			t.Fatalf("disabled request to %s returned %d", endpoint, out.Code)
+		}
+	}
+	if result.DefaultModel != "" || result.DefaultProvider != "" {
+		t.Fatal("disabled default retained")
+	}
+	loaded, err := config.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Providers["p"].IsEnabled() || loaded.Providers["p"].APIKey != "fixture-only" || len(loaded.Providers["p"].ActiveModels) != 1 || !loaded.Models["m"].Supports1M {
+		t.Fatal("settings did not persist")
+	}
+	store = NewSettingsStore(loaded, func(next *config.Config) error { return next.Save() })
+	server = &Server{settings: store}
+	result = put(`{"providers":[{"id":"p","enabled":true}]}`)
+	if len(result.Models) != 1 || !result.Providers[0].Enabled || result.Models[0].ContextWindow != 1000000 || !result.Providers[0].APIKeyConfigured {
+		t.Fatalf("reenable lost data: %+v", result)
+	}
+	result = put(`{"providers":[{"id":"p","models":[{"id":"m","supports1M":false,"contextWindow":200000}]}]}`)
+	if result.Models[0].Supports1M || result.Models[0].ContextWindow != 200000 {
+		t.Fatal("opt-out failed")
+	}
+}
