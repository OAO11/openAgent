diff --git a/internal/routing/openagent_context.go b/internal/routing/openagent_context.go
new file mode 100644
index 0000000..88a67c0
--- /dev/null
+++ b/internal/routing/openagent_context.go
@@ -0,0 +1,38 @@
+package routing
+
+import (
+	"strings"
+
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+)
+
+// Model-scoped opt-in for Anthropic-compatible relays that require the long
+// context beta. Never mutate the stored headers or rename the requested model.
+func providerForModel(prov config.Provider, model config.Model) config.Provider {
+	if !model.Supports1M || !(prov.API == ai.APIMessages || (prov.API == "" && prov.Type == "claude_code")) {
+		return prov
+	}
+	const beta = "context-1m-2025-08-07"
+	headers := make([]config.CustomHeader, 0, len(prov.CustomHeaders)+1)
+	tokens := []string{}
+	seen := map[string]bool{}
+	for _, header := range prov.CustomHeaders {
+		if !strings.EqualFold(header.Key, "anthropic-beta") {
+			headers = append(headers, header)
+			continue
+		}
+		for _, token := range strings.Split(header.Value, ",") {
+			token = strings.TrimSpace(token)
+			if token != "" && !seen[token] {
+				tokens = append(tokens, token)
+				seen[token] = true
+			}
+		}
+	}
+	if !seen[beta] {
+		tokens = append(tokens, beta)
+	}
+	prov.CustomHeaders = append(headers, config.CustomHeader{Key: "anthropic-beta", Value: strings.Join(tokens, ",")})
+	return prov
+}
