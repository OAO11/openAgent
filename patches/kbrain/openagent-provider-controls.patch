@@ -0,0 +1,61 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestOpenAgentProviderEnabledDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		raw     string
+		enabled bool
+	}{{`{}`, true}, {`{"enabled":true}`, true}, {`{"enabled":false}`, false}} {
+		var p Provider
+		if err := json.Unmarshal([]byte(tc.raw), &p); err != nil {
+			t.Fatal(err)
+		}
+		if p.IsEnabled() != tc.enabled || p.ModelActive("model") != tc.enabled {
+			t.Fatalf("enabled state for %s", tc.raw)
+		}
+	}
+}
+func TestOpenAgentProviderControlsPersistIndependently(t *testing.T) {
+	t.Setenv("K_BRAIN_HOME", t.TempDir())
+	disabled := false
+	m := Model{ID: "shared", Providers: []string{"a", "b"}, Context: 200000, MaxOut: 8192}
+	a := m
+	a.Supports1M = true
+	a.LimitsSource = "user"
+	m.SetProviderMetadata("a", a)
+	cfg := &Config{Providers: map[string]Provider{
+		"a": {Enabled: &disabled, API: "anthropic-messages", APIKey: "fixture-only", ActiveModels: []string{"shared"}},
+		"b": {API: "anthropic-messages", ActiveModels: []string{"shared"}},
+	}, Models: map[string]Model{"shared": m}}
+	if err := cfg.Save(); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Providers["a"].IsEnabled() || !loaded.Providers["b"].IsEnabled() {
+		t.Fatal("provider state lost")
+	}
+	if loaded.Providers["a"].APIKey != "fixture-only" || len(loaded.Providers["a"].ActiveModels) != 1 {
+		t.Fatal("disabled configuration lost")
+	}
+	ma, mb := loaded.Models["shared"].ForProvider("a"), loaded.Models["shared"].ForProvider("b")
+	if !ma.Supports1M || ma.ContextWindow() != 1000000 || mb.Supports1M || mb.ContextWindow() != 200000 {
+		t.Fatalf("overrides leaked: %v / %v", ma, mb)
+	}
+	if _, _, _, err := loaded.Resolve("shared", "a"); err == nil {
+		t.Fatal("disabled provider resolved")
+	}
+	enabled := true
+	p := loaded.Providers["a"]
+	p.Enabled = &enabled
+	loaded.Providers["a"] = p
+	if _, model, _, err := loaded.Resolve("shared", "a"); err != nil || !model.Supports1M {
+		t.Fatalf("reenabled route: %v", err)
+	}
+}
