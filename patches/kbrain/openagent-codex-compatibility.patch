index 0000000..3370156
--- /dev/null
+++ b/internal/ai/openagent_codex.go
@@ -0,0 +1,86 @@
+package ai
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+)
+
+// Opt in through the existing "Simulate CLI -> Codex" provider headers.
+// Never infer this from a model name, provider type, or endpoint hostname.
+func (c *Responses) codexCompatibility() bool {
+	return strings.HasPrefix(c.Headers.Get("User-Agent"), "codex_cli_rs/") &&
+		c.Headers.Get("Originator") == "codex_cli_rs"
+}
+
+// One backend process serves one openAgent desktop window. Generate an actual
+// runtime ID, not a copied official client's device or installation identity.
+var codexWindowID = sync.OnceValue(func() string { return newCodexRuntimeID() })
+
+func newCodexRuntimeID() string {
+	var id [16]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		panic(err)
+	}
+	id[6] = (id[6] & 0x0f) | 0x40
+	id[8] = (id[8] & 0x3f) | 0x80
+	return formatCodexRuntimeID(id[:])
+}
+
+func formatCodexRuntimeID(id []byte) string {
+	return fmt.Sprintf("%x-%x-%x-%x-%x", id[:4], id[4:6], id[6:8], id[8:10], id[10:16])
+}
+
+func (c *Responses) codexHeaders(ctx context.Context) http.Header {
+	headers := c.Headers.Clone()
+	scope, _ := ctx.Value(cacheRequestKey{}).(string)
+	threadID := ""
+	if scope != "" {
+		// Hash the local session scope so workspace paths and user labels never
+		// leave the application. Stable across turns, distinct across endpoints.
+		id := sha256.Sum256([]byte("openAgent/codex-thread/v1\x00" + c.Endpoint() + "\x00" + scope))
+		id[6] = (id[6] & 0x0f) | 0x80
+		id[8] = (id[8] & 0x3f) | 0x80
+		threadID = formatCodexRuntimeID(id[:16])
+	} else {
+		threadID = newCodexRuntimeID()
+	}
+	setDefault := func(name, value string) {
+		if !hasHeader(headers, name) {
+			headers.Set(name, value)
+		}
+	}
+	setDefault("Thread-Id", threadID)
+	setDefault("Session-Id", headers.Get("Thread-Id"))
+	setDefault("X-Client-Request-Id", headers.Get("Thread-Id"))
+	setDefault("X-Codex-Window-Id", codexWindowID())
+	return headers
+}
+
+func codexResponsesPayload(payload map[string]any, req Request, headers http.Header) error {
+	// Only lift the leading system prefix. Developer messages and later system
+	// messages retain their role and position, including tool/reasoning history.
+	prefix := 0
+	instructions := []string{}
+	for prefix < len(req.Messages) && req.Messages[prefix].Role == "system" {
+		instructions = append(instructions, req.Messages[prefix].TextContent())
+		prefix++
+	}
+	input, err := responsesInput(req.Messages[prefix:])
+	if err != nil {
+		return err
+	}
+	payload["instructions"] = strings.Join(instructions, "\n\n")
+	payload["input"] = input
+	payload["tool_choice"] = "auto"
+	payload["parallel_tool_calls"] = true
+	if _, ok := payload["tools"]; !ok {
+		payload["tools"] = []any{}
+	}
+	payload["client_metadata"] = map[string]string{"x-codex-window-id": headers.Get("X-Codex-Window-Id")}
+	return nil
+}
diff --git a/internal/ai/openagent_codex_test.go b/internal/ai/openagent_codex_test.go
