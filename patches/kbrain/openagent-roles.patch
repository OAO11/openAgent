+	prompt, err := WithResources("base", "", store)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(prompt, `role="review"`) || !strings.Contains(prompt, "Find defects") || strings.Contains(prompt, "private-role-body") || strings.Contains(prompt, "not-catalogued") {
+		t.Fatalf("catalog: %s", prompt)
+	}
+}
