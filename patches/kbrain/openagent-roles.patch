+package backend
+
+import (
+	"encoding/json"
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+	"net/http"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestOpenAgentRemoteCapabilitiesUnavailable(t *testing.T) {
+	_, base, _ := newHostBridgeServer(t, &hostToolClient{})
+	for _, path := range []string{"/v1/settings/ssh", "/v1/settings/ssh/hosts/legacy"} {
+		resp, err := http.Get(base + path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+		if resp.StatusCode != 404 {
+			t.Fatalf("%s status=%d", path, resp.StatusCode)
+		}
+	}
+	resp, err := http.Get(base + "/v1/health")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	var health map[string]any
+	if err = json.NewDecoder(resp.Body).Decode(&health); err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := json.Marshal(health)
+	if strings.Contains(string(raw), `"ssh_manager":1`) {
+		t.Fatal("SSH capability advertised")
+	}
+	code, _ := doHostBridge(t, base, http.MethodPut, map[string]any{"url": "http://127.0.0.1:45678", "token": "fixture-only", "tools": []string{"ReadTerminal", "TunnelManager", "SSHManager"}})
+	if code != 200 {
+		t.Fatalf("registration=%d", code)
+	}
+	status, _ := healthHostBridge(t, base)
+	if !slices.Equal(status.Tools, []string{"ReadTerminal"}) {
+		t.Fatalf("tools=%v", status.Tools)
+	}
+	for _, name := range []string{"SSHManager", "TunnelManager"} {
+		_, err := normalizeClientTools([]protocol.ClientTool{{Name: name, Description: "legacy tool", Parameters: json.RawMessage(`{"type":"object"}`)}}, nil)
+		if err == nil {
+			t.Fatalf("remote client tool %s accepted", name)
+		}
+	}
+}
