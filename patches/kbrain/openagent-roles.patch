+package backend
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/Stack-Cairn/K-brain/internal/datapath"
+)
+
+type openAgentStoreTransport func(*http.Request) (*http.Response, error)
+
+func (f openAgentStoreTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestOpenAgentSkillsStoreHTTPParameters(t *testing.T) {
+	t.Setenv(datapath.LiveAgentHomeEnv, t.TempDir())
+	oldTransport := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = oldTransport })
+	for _, tc := range []struct{ path, route, field string }{
+		{"/v1/skills/store/search?sort=stars&limit=7&cursor=next%2Bpage&ownerHandle=alice", "/api/v1/skills", "items"},
+		{"/v1/skills/store/search?q=code%20review&limit=7&ownerHandle=alice", "/api/v1/search", "results"},
+	} {
+		t.Run(tc.route, func(t *testing.T) {
+			called := false
+			http.DefaultTransport = openAgentStoreTransport(func(r *http.Request) (*http.Response, error) {
+				called = true
+				if r.URL.Host != "clawhub.ai" || r.URL.Path != tc.route {
+					t.Fatalf("wrong upstream route: %s", r.URL)
+				}
+				q := r.URL.Query()
+				if q.Get("limit") != "7" || q.Get("ownerHandle") != "alice" || q.Get("nonSuspiciousOnly") != "true" {
+					t.Fatalf("lost query: %s", r.URL.RawQuery)
+				}
+				if tc.field == "items" {
+					if q.Get("sort") != "stars" || q.Get("cursor") != "next+page" {
+						t.Fatalf("lost catalog arguments: %v", q)
+					}
+				} else if q.Get("q") != "code review" {
+					t.Fatalf("lost search query: %v", q)
+				}
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"` + tc.field + `":[{"slug":"review","latestVersion":{"version":"2.1.0"},"stats":{"downloads":123}}],"nextCursor":"next-result"}`))}, nil
+			})
+			response := httptest.NewRecorder()
+			(&Server{}).handleSkills(response, httptest.NewRequest(http.MethodGet, tc.path, nil))
+			if !called || response.Code != 200 {
+				t.Fatalf("store response: %d %s", response.Code, response.Body.String())
+			}
+			var body struct {
+				Results []struct {
+					Slug, LatestVersion string
+					Downloads           int64
+				}
+				NextCursor string
+			}
+			if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+				t.Fatal(err)
+			}
+			if len(body.Results) != 1 || body.Results[0].LatestVersion != "2.1.0" || body.Results[0].Downloads != 123 || body.NextCursor != "next-result" {
+				t.Fatalf("lost store response: %+v", body)
+			}
+		})
+	}
+}
