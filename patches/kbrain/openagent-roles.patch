@@ -0,0 +1,122 @@
+package skills
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestOpenAgentReviewOwnershipAndSelection(t *testing.T) {
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(m.root, openAgentReviewName)
+	if err = os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	body := "---\nname: openagent-code-review\ndescription: Review\n---\nReview instructions.\n"
+	if err = os.WriteFile(filepath.Join(dir, "SKILL.md"), []byte(body), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if m.isBuiltinTarget(openAgentReviewName) {
+		t.Fatal("unmarked user skill is protected")
+	}
+	if err = os.WriteFile(filepath.Join(dir, "_openagent_builtin.json"), []byte(openAgentReviewMarker), 0600); err != nil {
+		t.Fatal(err)
+	}
+	all, _, err := m.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, s := range all {
+		if s.Name == openAgentReviewName {
+			found = s.BuiltIn
+		}
+	}
+	if !found {
+		t.Fatal("desktop builtin identity lost in backend list")
+	}
+	if _, err = m.Delete(openAgentReviewName); err == nil {
+		t.Fatal("deleted managed builtin")
+	}
+	if _, err = m.Create(openAgentReviewName, "replace", "body", "overwrite", nil); err == nil {
+		t.Fatal("replaced managed builtin")
+	}
+	project := t.TempDir()
+	for _, workdir := range []string{"", project} {
+		if _, err = m.SaveSettings(workdir, SkillSettings{Enabled: true, Selected: []string{"liveagent-code-review"}}); err != nil {
+			t.Fatal(err)
+		}
+		_, settings, err := m.Settings(workdir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !slices.Contains(settings.Selected, openAgentReviewName) || slices.Contains(settings.Selected, "liveagent-code-review") {
+			t.Fatalf("selection not migrated: %+v", settings)
+		}
+	}
+	// Simulate pre-upgrade settings on disk, not just a new settings save.
+	if err = os.WriteFile(m.settingsPath(), []byte(`{"global":{"enabled":true,"selected":["liveagent-code-review"]}}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	_, settings, err := m.Settings("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Contains(settings.Selected, openAgentReviewName) {
+		t.Fatal("legacy stored selection lost")
+	}
+	// A remaining legacy namesake belongs to the user and must keep its selection.
+	if err = os.Mkdir(filepath.Join(m.root, "liveagent-code-review"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if got := m.normalizeReviewSelection(SkillSettings{Selected: []string{"liveagent-code-review"}}); got.Selected[0] != "liveagent-code-review" {
+		t.Fatal("renamed user skill selection")
+	}
+}
+
+func TestOpenAgentDevelopmentBuiltinOwnership(t *testing.T) {
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"openagent-architecture", "openagent-frontend", "openagent-postgres", "openagent-deployment"} {
+		dir := filepath.Join(m.root, name)
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		body := "---\nname: " + name + "\ndescription: Development skill\n---\nFull instructions.\n"
+		if err := os.WriteFile(filepath.Join(dir, "SKILL.md"), []byte(body), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if m.isBuiltinTarget(name) {
+			t.Fatal("unmarked namesake was claimed")
+		}
+		marker := "{\"schemaVersion\":1,\"owner\":\"openAgent\",\"skill\":\"" + name + "\"}\n"
+		if err := os.WriteFile(filepath.Join(dir, "_openagent_builtin.json"), []byte(marker), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if !m.isBuiltinTarget(name) {
+			t.Fatalf("packaged skill not protected: %s", name)
+		}
+		if _, err := m.Delete(name); err == nil {
+			t.Fatal("managed builtin deleted")
+		}
+		if _, err := m.Create(name, "replace", "body", "overwrite", nil); err == nil {
+			t.Fatal("managed builtin overwritten")
+		}
+	}
+	// A marker cannot turn arbitrary user skills into product-owned ones.
+	unknown := "openagent-my-custom-skill"
+	dir := filepath.Join(m.root, unknown)
+	os.MkdirAll(dir, 0700)
+	os.WriteFile(filepath.Join(dir, "_openagent_builtin.json"), []byte("{\"schemaVersion\":1,\"owner\":\"openAgent\",\"skill\":\""+unknown+"\"}\n"), 0600)
+	if m.isBuiltinTarget(unknown) {
+		t.Fatal("unknown name accepted as built-in")
+	}
+}
diff --git a/internal/skills/openagent_store.go b/internal/skills/openagent_store.go
new file mode 100644
index 0000000..e1d4a1d
--- /dev/null
+++ b/internal/skills/openagent_store.go
@@ -0,0 +1,161 @@
+package skills
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// The catalog and keyword search have different routes and response envelopes.
+// Keep registry transport inside K-brain, including filtering and pagination.
+func (m *Manager) searchStore(ctx context.Context, a map[string]any) ([]ClawHubCard, string, error) {
+	ctx, cancel := context.WithTimeout(ctx, 25*time.Second)
+	defer cancel()
+	query := strings.TrimSpace(stringArg(a, "query"))
+	path, field := "/api/v1/skills", "items"
+	q := url.Values{"nonSuspiciousOnly": {"true"}}
+	limit := intArg(a, "limit", 24)
+	if limit < 1 {
+		limit = 24
+	}
+	if limit > 100 {
+		limit = 100
+	}
+	q.Set("limit", strconv.Itoa(limit))
+	if query != "" {
+		path, field = "/api/v1/search", "results"
+		q.Set("q", query)
+	} else {
+		sort := stringArg(a, "sort")
+		switch sort {
+		case "", "downloads":
+			sort = "downloads"
+		case "stars", "installs", "updated", "newest":
+		default:
+			return nil, "", errors.New("unsupported ClawHub sort")
+		}
+		q.Set("sort", sort)
+		if cursor := stringArg(a, "cursor"); cursor != "" {
+			q.Set("cursor", cursor)
+		}
+	}
+	if owner := strings.TrimSpace(stringArg(a, "ownerHandle")); owner != "" {
+		q.Set("ownerHandle", owner)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, strings.TrimRight(m.storeURL, "/")+path+"?"+q.Encode(), nil)
+	if err != nil {
+		return nil, "", err
+	}
+	req.Header.Set("Accept", "application/json")
+	resp, err := m.client.Do(req)
+	if err != nil {
+		return nil, "", fmt.Errorf("ClawHub request: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, "", fmt.Errorf("ClawHub request returned HTTP %d", resp.StatusCode)
+	}
+	var envelope map[string]json.RawMessage
+	if err = json.NewDecoder(io.LimitReader(resp.Body, maxReadBytes)).Decode(&envelope); err != nil {
+		return nil, "", fmt.Errorf("invalid ClawHub response: %w", err)
+	}
+	raw, ok := envelope[field]
+	if !ok {
+		return nil, "", fmt.Errorf("ClawHub response is missing %s", field)
+	}
+	var rows []registryCard
+	if err = json.Unmarshal(raw, &rows); err != nil {
+		return nil, "", fmt.Errorf("invalid ClawHub %s: %w", field, err)
+	}
+	var cursor string
+	if raw := envelope["nextCursor"]; len(raw) > 0 {
+		if err = json.Unmarshal(raw, &cursor); err != nil {
+			return nil, "", fmt.Errorf("invalid ClawHub cursor: %w", err)
+		}
+	}
+	out := make([]ClawHubCard, 0, len(rows))
+	for _, row := range rows {
+		// This store installs ClawHub archives; federated search may also return other registries.
+		if row.Source != "" && row.Source != "clawhub" {
+			continue
+		}
+		if strings.TrimSpace(row.Slug) == "" {
+			return nil, "", errors.New("ClawHub item has no slug")
+		}
+		out = append(out, row.card())
+	}
+	return out, cursor, nil
+}
+
+type registryStats struct{ Downloads, Stars, Installs, InstallsCurrent *int64 }
+type registryOwner struct{ Handle string }
+type registryCard struct {
+	Slug, DisplayName, Summary, Source, OwnerHandle, WebURL, DownloadURL string
+	LatestVersion                                                        json.RawMessage
+	Version                                                              json.RawMessage
+	Downloads, Stars, InstallsCurrent, Installs, UpdatedAt               *int64
+	Topics                                                               []string
+	Stats                                                                registryStats
+	Tags                                                                 struct{ Latest string }
+	Owner                                                                registryOwner
+	Publisher                                                            registryOwner
+	Native                                                               struct {
+		OwnerHandle string
+		Owner       registryOwner
+		Version     json.RawMessage
+		Skill       struct {
+			Stats  registryStats
+			Topics []string
+		}
+	}
+}
+
+func registryVersion(raw json.RawMessage) string {
+	var value string
+	if json.Unmarshal(raw, &value) == nil {
+		return value
+	}
+	var obj struct{ Version string }
+	if json.Unmarshal(raw, &obj) == nil {
+		return obj.Version
+	}
+	return ""
+}
+func firstRegistryText(values ...string) string {
+	for _, v := range values {
+		if strings.TrimSpace(v) != "" {
+			return v
+		}
+	}
+	return ""
+}
+func firstRegistryCount(values ...*int64) int64 {
+	for _, v := range values {
+		if v != nil {
+			return *v
+		}
+	}
+	return 0
+}
+func (r registryCard) card() ClawHubCard {
+	topics := r.Topics
+	if len(topics) == 0 {
+		topics = r.Native.Skill.Topics
+	}
+	owner := firstRegistryText(r.OwnerHandle, r.Owner.Handle, r.Publisher.Handle, r.Native.OwnerHandle, r.Native.Owner.Handle)
+	version := firstRegistryText(registryVersion(r.LatestVersion), registryVersion(r.Version), registryVersion(r.Native.Version), r.Tags.Latest)
+	return ClawHubCard{
+		Slug: r.Slug, DisplayName: firstRegistryText(r.DisplayName, r.Slug), Summary: r.Summary, LatestVersion: version,
+		OwnerHandle: owner, WebURL: r.WebURL, DownloadURL: r.DownloadURL, Topics: topics, UpdatedAt: r.UpdatedAt,
+		Downloads:       firstRegistryCount(r.Downloads, r.Stats.Downloads, r.Native.Skill.Stats.Downloads),
+		Stars:           firstRegistryCount(r.Stars, r.Stats.Stars, r.Native.Skill.Stats.Stars),
+		InstallsCurrent: firstRegistryCount(r.InstallsCurrent, r.Installs, r.Stats.InstallsCurrent, r.Stats.Installs, r.Native.Skill.Stats.InstallsCurrent, r.Native.Skill.Stats.Installs),
+	}
+}
diff --git a/internal/skills/openagent_store_test.go b/internal/skills/openagent_store_test.go
new file mode 100644
index 0000000..04fd2f1
--- /dev/null
+++ b/internal/skills/openagent_store_test.go
@@ -0,0 +1,86 @@
+package skills
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestOpenAgentStoreCatalogAndSearch(t *testing.T) {
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		if q.Get("limit") != "2" || q.Get("nonSuspiciousOnly") != "true" {
+			t.Errorf("query = %v", q)
+		}
+		switch r.URL.Path {
+		case "/api/v1/skills":
+			if q.Get("sort") != "stars" || q.Get("cursor") != "next + cursor" || q.Get("q") != "" {
+				t.Errorf("catalog query = %v", q)
+			}
+			fmt.Fprint(w, `{"items":[{"slug":"review","ownerHandle":"alice","displayName":"Review","topics":["coding"],"latestVersion":{"version":"2.1.0"},"stats":{"downloads":123,"stars":9,"installs":7},"updatedAt":123456}],"nextCursor":"page-two"}`)
+		case "/api/v1/search":
+			if q.Get("q") != "code review" || q.Get("ownerHandle") != "alice" {
+				t.Errorf("search query = %v", q)
+			}
+			fmt.Fprint(w, `{"results":[{"slug":"review","source":"clawhub","displayName":"Review","owner":{"handle":"alice"},"version":null,"native":{"skill":{"stats":{"downloads":123,"stars":9,"installs":7},"topics":["coding"]}}},{"slug":"legacy","ownerHandle":"bob","latestVersion":"1.0.0","downloads":8},{"slug":"other","source":"skills-sh"}]}`)
+		default:
+			t.Errorf("unexpected path %s", r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer srv.Close()
+	m.storeURL = srv.URL
+	if err := m.SetHTTPClient(srv.Client()); err != nil {
+		t.Fatal(err)
+	}
+	out, cursor, err := m.searchStore(context.Background(), map[string]any{"sort": "stars", "cursor": "next + cursor", "limit": 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != 1 || cursor != "page-two" {
+		t.Fatalf("catalog = %+v, %q", out, cursor)
+	}
+	if c := out[0]; c.LatestVersion != "2.1.0" || c.Downloads != 123 || c.Stars != 9 || c.OwnerHandle != "alice" {
+		t.Fatalf("card = %+v", c)
+	}
+	out, cursor, err = m.searchStore(context.Background(), map[string]any{"query": " code review ", "limit": float64(2), "ownerHandle": "alice"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != 2 || cursor != "" || out[0].OwnerHandle != "alice" || out[0].Stars != 9 || out[1].LatestVersion != "1.0.0" {
+		t.Fatalf("search = %+v, %q", out, cursor)
+	}
+}
+
+func TestOpenAgentStoreErrorsAreNotEmptyResults(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		status     int
+	}{
+		{"rate-limited", `{"error":"rate limit"}`, 429},
+		{"wrong-shape", `{"unexpected":[]}`, 200},
+		{"malformed", `<html>unavailable</html>`, 200},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("LIVEAGENT_HOME", t.TempDir())
+			m, err := NewManager()
+			if err != nil {
+				t.Fatal(err)
+			}
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(tc.status); fmt.Fprint(w, tc.body) }))
+			defer srv.Close()
+			m.storeURL = srv.URL
+			_ = m.SetHTTPClient(srv.Client())
+			if _, _, err = m.searchStore(context.Background(), map[string]any{}); err == nil {
+				t.Fatal("upstream failure reported as empty catalog")
+			}
+		})
+	}
+}
