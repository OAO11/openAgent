+// Role settings are authoritative when selected. Missing/disabled roles and
+// unavailable models fail explicitly; they never silently switch providers.
+func (a *Agent) resolveSubagentRole(id, model, provider, effort string) (SubModel, error) {
+	var role SubagentRole
+	if id != "" {
+		if a.ResolveRole == nil {
+			return SubModel{}, errors.New("subagent roles are unavailable")
+		}
+		var err error
+		role, err = a.ResolveRole(id)
+		if err != nil {
+			return SubModel{}, err
+		}
+		if role.Model != "" {
+			model, provider = role.Model, role.Provider
+		}
+		if role.Reasoning != "" {
+			effort = role.Reasoning
+		}
+	}
+	o, err := a.resolveSub(model, provider)
+	if err != nil {
+		return SubModel{}, err
+	}
+	if effort != "" {
+		o.Effort = effort
+	}
+	o.RolePrompt = role.Prompt
+	o.RoleID, o.RoleName = id, role.Name
+	return o, nil
+}
