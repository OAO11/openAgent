+++ b/internal/backend/openagent_subagent_roles_test.go
@@ -0,0 +1,103 @@
+package backend
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Stack-Cairn/K-brain/internal/agent"
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+	"github.com/Stack-Cairn/K-brain/internal/session"
+)
+
+func TestOpenAgentRoleEvidenceSurvivesRestart(t *testing.T) {
+	for _, background := range []bool{false, true} {
+		name := "foreground"
+		if background {
+			name = "background"
+		}
+		t.Run(name, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var req ai.Request
+				if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+					t.Error(err)
+					return
+				}
+				if isSubagentRequest(req) {
+					if !strings.Contains(req.Messages[0].Content, "ROLE_BODY_ACTUALLY_APPLIED") {
+						t.Error("role body missing from child request")
+					}
+					writeSubagentWorkflowStream(w, "role report")
+					return
+				}
+				for _, message := range req.Messages {
+					if message.Role == "tool" {
+						writeSubagentWorkflowStream(w, "parent finished")
+						return
+					}
+				}
+				args, _ := json.Marshal(map[string]any{"description": "role proof", "prompt": "inspect", "role": "review", "background": background})
+				writeSubagentWorkflowToolCall(w, string(args))
+			}))
+			defer upstream.Close()
+			storeDir, eventDir := t.TempDir(), t.TempDir()
+			store, err := session.Open(storeDir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			factory := func(_ context.Context, _ string, model protocol.ModelRef) (*agent.Agent, error) {
+				ag := agent.New(ai.New(upstream.URL, "fixture"), model.Model, 1024, "parent")
+				ag.ResolveRole = func(id string) (agent.SubagentRole, error) {
+					return agent.SubagentRole{Name: "Original reviewer", Prompt: "ROLE_BODY_ACTUALLY_APPLIED"}, nil
+				}
+				return ag, nil
+			}
+			backend, err := New(Options{Store: store, Factory: factory, EventDir: eventDir, Models: []protocol.ModelRef{{Provider: "fixture", Model: "fixture-model"}}, DefaultCWD: t.TempDir()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := httptest.NewServer(backend)
+			defer func() { server.Close(); _ = backend.Close(); _ = store.Close() }()
+			sess := createTestSession(t, server.URL)
+			runRequest(t, server.URL, sess.ID, "role-proof", "delegate")
+			deadline := time.Now().Add(10 * time.Second)
+			var listed protocol.SubagentList
+			for time.Now().Before(deadline) {
+				listed = getSubagents(t, server.URL, sess.ID)
+				if len(listed.Subagents) == 1 && listed.Subagents[0].Status == "done" {
+					break
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			check := func(list protocol.SubagentList) {
+				t.Helper()
+				if len(list.Subagents) != 1 {
+					t.Fatalf("subagent count: %d", len(list.Subagents))
+				}
+				got := list.Subagents[0]
+				if got.RoleID != "review" || got.RoleName != "Original reviewer" || got.Status != "done" {
+					t.Fatalf("incorrect role evidence: %+v", got)
+				}
+			}
+			check(listed)
+			_ = backend.Close()
+			server.Close()
+			_ = store.Close()
+			store2, err := session.Open(storeDir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer store2.Close()
+			// No resolver is provided after restart: historical role evidence must not
+			// depend on the role still existing or having the same name in settings.
+			backend2, server2 := newSubagentWorkflowServer(t, store2, eventDir, ai.New(upstream.URL, "fixture"))
+			defer func() { server2.Close(); _ = backend2.Close() }()
+			check(getSubagents(t, server2.URL, sess.ID))
+		})
+	}
+}
