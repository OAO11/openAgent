@@ -0,0 +1,53 @@
+package resources
+
+import "testing"
+
+func TestOpenAgentRoleRoundTripAndIndependentActivation(t *testing.T) {
+	root := t.TempDir()
+	store, err := OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	items := []AgentTemplate{
+		{ID: "parent", Name: "Parent", Prompt: "parent-only", Enabled: true},
+		{ID: "review", Name: "Review", Prompt: "review-only", RoleEnabled: true, RoleProviderID: "provider-a", RoleModelID: "model-a", RoleReasoning: "xhigh"},
+		{ID: "test", Name: "Test", Prompt: "test-only", RoleEnabled: true, RoleReasoning: "off"},
+	}
+	if _, err = store.Replace(items, nil); err != nil {
+		t.Fatal(err)
+	}
+	store, err = OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := store.Snapshot().Templates
+	if len(got) != 3 || got[1] != items[1] || got[2] != items[2] {
+		t.Fatalf("role reload: %+v", got)
+	}
+	enabled := true
+	if _, err = store.Patch("review", TemplatePatch{Enabled: &enabled}); err != nil {
+		t.Fatal(err)
+	}
+	got = store.Snapshot().Templates
+	if got[0].Enabled || !got[1].Enabled || !got[1].RoleEnabled || !got[2].RoleEnabled {
+		t.Fatalf("independent activation: %+v", got)
+	}
+	global, _, _, err := store.Resolve("", nil)
+	if err != nil || global != "review-only" {
+		t.Fatalf("global=%q err=%v", global, err)
+	}
+	invalid := "ultra"
+	if _, err = store.Patch("review", TemplatePatch{RoleReasoning: &invalid}); err == nil {
+		t.Fatal("invalid effort accepted")
+	}
+	if store.Snapshot().Templates[1].RoleReasoning != "xhigh" {
+		t.Fatal("failed update mutated role")
+	}
+	disabled := false
+	if _, err = store.Patch("review", TemplatePatch{RoleEnabled: &disabled}); err != nil {
+		t.Fatal(err)
+	}
+	if !store.Snapshot().Templates[1].Enabled {
+		t.Fatal("role toggle changed global activation")
+	}
+}
