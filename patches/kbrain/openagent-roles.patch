--- /dev/null
+++ b/internal/agent/openagent_roles_test.go
@@ -0,0 +1,92 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"strings"
+	"testing"
+)
+
+func TestOpenAgentRoleAppliesModelPromptReasoning(t *testing.T) {
+	server, models := modelRecorder(t, "role report")
+	defer server.Close()
+	parent := New(ai.New(server.URL, "fixture"), "parent-model", 100, "parent-only")
+	parent.Effort = "low"
+	parent.ResolveRole = func(id string) (SubagentRole, error) {
+		if id != "review" {
+			return SubagentRole{}, errors.New("disabled role")
+		}
+		return SubagentRole{Prompt: "review-only", Model: "role-model", Provider: "role-provider", Reasoning: "xhigh"}, nil
+	}
+	parent.ResolveModel = func(model, provider string) (SubModel, error) {
+		if model != "role-model" || provider != "role-provider" {
+			t.Fatalf("route %s/%s", provider, model)
+		}
+		return SubModel{Client: ai.New(server.URL, "fixture"), Model: model, Provider: provider}, nil
+	}
+	configured, err := parent.resolveSubagentRole("review", "ignored-model", "ignored-provider", "off")
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := parent.newSub(configured)
+	if child.Model != "role-model" || child.Effort != "xhigh" || !strings.Contains(child.Messages[0].Content, "review-only") || strings.Contains(child.Messages[0].Content, "parent-only") {
+		t.Fatal("role was not applied to the child")
+	}
+	child.setWorktree(context.Background(), t.TempDir())
+	if !strings.Contains(child.Messages[0].Content, "review-only") {
+		t.Fatal("worktree discarded role prompt")
+	}
+	out, err := findTool(t, parent, "subagent").Run(context.Background(), json.RawMessage(`{"role":"review","prompt":"inspect"}`))
+	if err != nil || out != "role report" || len(models()) != 1 || models()[0] != "role-model" {
+		t.Fatalf("role tool: %q %v %v", out, err, models())
+	}
+	_, err = parent.resolveSubagentRole("disabled", "", "", "")
+	if err == nil {
+		t.Fatal("disabled role accepted")
+	}
+	parent.ResolveRole = func(id string) (SubagentRole, error) {
+		return SubagentRole{Prompt: "inherited-model-role", Reasoning: "off"}, nil
+	}
+	configured, err = parent.resolveSubagentRole("inherit", "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	child = parent.newSub(configured)
+	if child.Model != "parent-model" || child.Effort != "off" || !strings.Contains(child.Messages[0].Content, "inherited-model-role") {
+		t.Fatal("inherit model lost explicit role instructions or thinking off")
+	}
+	parent.ResolveRole = func(id string) (SubagentRole, error) { return SubagentRole{Model: "missing"}, nil }
+	parent.ResolveModel = func(model, provider string) (SubModel, error) { return SubModel{}, errors.New("model unavailable") }
+	if _, err = parent.resolveSubagentRole("missing", "", "", ""); err == nil {
+		t.Fatal("unavailable model silently fell back")
+	}
+}
+
+// Role identity must describe the prompt actually installed on the child, even
+// when the child inherits its model or outlives the parent turn.
+func TestOpenAgentRoleIdentitySurvivesModelInheritance(t *testing.T) {
+	parent := New(ai.New("http://127.0.0.1:1", "fixture"), "parent", 100, "parent")
+	parent.TaskDefault = SubModel{Client: ai.New("http://127.0.0.1:1", "fixture"), Model: "default"}
+	parent.ResolveRole = func(id string) (SubagentRole, error) {
+		return SubagentRole{Name: "代码审查", Prompt: "review-only"}, nil
+	}
+	opts, err := parent.resolveSubagentRole("review", "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := parent.newSub(opts)
+	if child.RoleID != "review" || child.RoleName != "代码审查" || child.Model != "default" || !strings.Contains(child.Messages[0].Content, "review-only") {
+		t.Fatalf("role metadata does not match applied prompt: %q %q %q", child.RoleID, child.RoleName, child.Model)
+	}
+	task := parent.RegisterBackground("review task", "inspect", opts)
+	if task.RoleID != "review" || task.RoleName != "代码审查" {
+		t.Fatal("background lost role identity")
+	}
+	parent.Tasks().CancelRunning()
+	plain := child.newSub(SubModel{})
+	if plain.RoleID != "" || plain.RoleName != "" || strings.Contains(plain.Messages[0].Content, "review-only") {
+		t.Fatal("unselected nested child incorrectly inherited its parent's role")
+	}
+}
