index 0000000..f323432
--- /dev/null
+++ b/internal/skills/openagent_builtin.go
@@ -0,0 +1,76 @@
+package skills
+
+import (
+	"os"
+	"path/filepath"
+)
+
+const openAgentReviewName = "openagent-code-review"
+const openAgentReviewMarker = "{\"schemaVersion\":1,\"owner\":\"openAgent\",\"skill\":\"openagent-code-review\"}\n"
+
+var openAgentBuiltinNames = map[string]bool{
+	openAgentReviewName:              true,
+	"openagent-development-workflow": true,
+	"openagent-planning":             true,
+	"openagent-architecture":         true,
+	"openagent-api-design":           true,
+	"openagent-backend":              true,
+	"openagent-frontend":             true,
+	"openagent-react-performance":    true,
+	"openagent-postgres":             true,
+	"openagent-database-migrations":  true,
+	"openagent-tdd":                  true,
+	"openagent-debugging":            true,
+	"openagent-web-testing":          true,
+	"openagent-security-review":      true,
+	"openagent-performance":          true,
+	"openagent-deployment":           true,
+	"openagent-containers":           true,
+}
+
+// The desktop seeds these reviewed skills. Only its ownership marker makes it a managed
+// builtin; an unmarked same-name user skill keeps its normal management rights.
+func (m *Manager) isBuiltinTarget(name string) bool {
+	if isBuiltin(name) {
+		return true
+	}
+	if !openAgentBuiltinNames[name] {
+		return false
+	}
+	path, err := safePath(m.root, name+"/_openagent_builtin.json")
+	if err != nil {
+		return false
+	}
+	body, err := os.ReadFile(path)
+	expected := "{\"schemaVersion\":1,\"owner\":\"openAgent\",\"skill\":\"" + name + "\"}\n"
+	return err == nil && string(body) == expected
+}
+
+func (m *Manager) normalizeReviewSelection(v SkillSettings) SkillSettings {
+	if !m.isBuiltinTarget(openAgentReviewName) {
+		return v
+	}
+	if _, err := os.Lstat(filepath.Join(m.root, "liveagent-code-review")); !os.IsNotExist(err) {
+		return v
+	}
+	rename := func(names []string) []string {
+		if names == nil {
+			return nil
+		}
+		out := make([]string, 0, len(names))
+		seen := map[string]bool{}
+		for _, name := range names {
+			if name == "liveagent-code-review" {
+				name = openAgentReviewName
+			}
+			if !seen[name] {
+				out = append(out, name)
+				seen[name] = true
+			}
+		}
+		return out
+	}
+	v.Selected = rename(v.Selected)
+	v.SkillNames = rename(v.SkillNames)
+	return v
+}
