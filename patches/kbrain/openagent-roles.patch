+	store, err := resources.OpenPrompts(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = store.Replace([]resources.AgentTemplate{
+		{ID: "review", Name: "Reviewer", Description: "Find defects", Prompt: "private-role-body", RoleEnabled: true},
+		{ID: "disabled", Name: "Disabled", Prompt: "not-catalogued"},
+	}, nil)
+	if err != nil {
+		t.Fatal(err)
