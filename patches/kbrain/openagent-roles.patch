+++ b/internal/resources/openagent_presets_test.go
@@ -0,0 +1,131 @@
+package resources
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestOpenAgentPresetsSeedOncePreservingEditsAndDeletion(t *testing.T) {
+	t.Setenv("OPENAGENT_BUILTIN_PROMPTS", "")
+	root := t.TempDir()
+	s, err := OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = s.Create(AgentTemplate{ID: "openagent-architect", Name: "我的架构师", Prompt: "custom", Enabled: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OPENAGENT_BUILTIN_PROMPTS", "1")
+	s, err = OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := s.Snapshot()
+	if len(state.Templates) != 8 {
+		t.Fatalf("templates=%d", len(state.Templates))
+	}
+	for _, item := range state.Templates {
+		if item.ID == "openagent-architect" {
+			if item.Prompt != "custom" || !item.Enabled {
+				t.Fatal("existing template overwritten")
+			}
+		} else if item.Enabled || !item.RoleEnabled {
+			t.Fatal("unexpected preset switches")
+		}
+	}
+	if _, err = s.Delete("openagent-reviewer", nil); err != nil {
+		t.Fatal(err)
+	}
+	s, err = OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(s.Snapshot().Templates) != 7 {
+		t.Fatal("deleted preset resurrected")
+	}
+	if s.Snapshot().BuiltinVersion != 2 {
+		t.Fatal("seed marker missing")
+	}
+}
+func TestOpenAgentPresetsPersistFailureDoesNotCreateMarker(t *testing.T) {
+	t.Setenv("OPENAGENT_BUILTIN_PROMPTS", "1")
+	root := filepath.Join(t.TempDir(), "file")
+	if err := os.WriteFile(root, []byte("x"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := OpenPrompts(root); err == nil {
+		t.Fatal("expected persistence failure")
+	}
+}
+
+func TestOpenAgentFullPresetsUpgradeOnlyUntouchedBodies(t *testing.T) {
+	t.Setenv("OPENAGENT_BUILTIN_PROMPTS", "1")
+	root := t.TempDir()
+	var old []AgentTemplate
+	if err := json.Unmarshal(openAgentPresetsV1, &old); err != nil {
+		t.Fatal(err)
+	}
+	// User configuration is independent of the body: preserve these settings.
+	old[0].Name = "My coordinator"
+	old[0].Enabled = true
+	old[0].RoleEnabled = false
+	old[0].RoleModelID = "custom-model"
+	old[1].Prompt = "my edited architecture prompt"
+	old = old[:len(old)-1] // A deleted preset must not return during the migration.
+	data, err := json.Marshal(diskState{BuiltinVersion: 1, Revision: 7, Templates: old})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(root, "agents.json"), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	s, err := OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	state := s.Snapshot()
+	if len(state.Templates) != 7 || state.BuiltinVersion != 2 || state.Revision != 8 {
+		t.Fatalf("bad upgrade: %d %d %d", len(state.Templates), state.BuiltinVersion, state.Revision)
+	}
+	first := state.Templates[0]
+	if first.Name != "My coordinator" || !first.Enabled || first.RoleEnabled || first.RoleModelID != "custom-model" || len(first.Prompt) < 10000 {
+		t.Fatal("upgrade lost settings or retained abbreviated body")
+	}
+	if state.Templates[1].Prompt != old[1].Prompt {
+		t.Fatal("user body overwritten")
+	}
+	for _, item := range state.Templates {
+		if item.ID == "openagent-release" {
+			t.Fatal("deleted template restored")
+		}
+	}
+	s, err = OpenPrompts(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Snapshot().Revision != 8 {
+		t.Fatal("upgrade repeated on restart")
+	}
+}
+
+func TestOpenAgentArchitectContainsCompleteOriginalSections(t *testing.T) {
+	t.Setenv("OPENAGENT_BUILTIN_PROMPTS", "1")
+	s, err := OpenPrompts(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range s.Snapshot().Templates {
+		if item.ID != "openagent-architect" {
+			continue
+		}
+		if len(item.Prompt) < 6000 || !strings.Contains(item.Prompt, "Software Architect") {
+			t.Fatal("abbreviated architect body")
+		}
+		return
+	}
+	t.Fatal("architect preset missing")
+}
