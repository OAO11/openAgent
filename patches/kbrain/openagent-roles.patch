+//go:embed openagent-presets.json
+var openAgentPresets []byte
+
+// The old bodies identify untouched presets without overwriting user edits.
+//go:embed openagent-presets-v1.json
+var openAgentPresetsV1 []byte
+
+//go:embed LICENSE.agency-agents
+var openAgentPresetLicense string
+
+func (s *PromptStore) seedOpenAgentPresets() error {
+	if s.state.BuiltinVersion >= 2 {
+		return nil
+	}
+	var presets []AgentTemplate
+	if err := json.Unmarshal(openAgentPresets, &presets); err != nil {
+		return err
+	}
+	next := cloneState(s.state)
+	existing := map[string]bool{}
+	for _, item := range next.Templates {
+		existing[item.ID] = true
+	}
+	if s.state.BuiltinVersion == 0 {
+		for _, item := range presets {
+			if !existing[item.ID] {
+				next.Templates = append(next.Templates, item)
+			}
+		}
+	} else {
+		var previous []AgentTemplate
+		if err := json.Unmarshal(openAgentPresetsV1, &previous); err != nil {
+			return err
+		}
+		oldBodies := map[string]string{}
+		newBodies := map[string]string{}
+		for _, item := range previous {
+			oldBodies[item.ID] = item.Prompt
+		}
+		for _, item := range presets {
+			newBodies[item.ID] = item.Prompt
+		}
+		// Only migrate bodies that still exactly match v1. Do not re-add deleted
+		// templates or reset user names, switches, models or reasoning settings.
+		for i, item := range next.Templates {
+			if old, ok := oldBodies[item.ID]; ok && item.Prompt == old {
+				if body, ok := newBodies[item.ID]; ok {
+					next.Templates[i].Prompt = body
+				}
+			}
+		}
+	}
+	if err := validateTemplates(next.Templates); err != nil {
+		return err
+	}
+	next.BuiltinVersion = 2
+	next.Revision++
+	if err := s.persist(next, false); err != nil {
+		return err
+	}
+	s.state = next
+	return nil
+}
